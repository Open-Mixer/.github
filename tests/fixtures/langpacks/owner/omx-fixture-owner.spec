# The owner fixture of tests/langpacks.sh: an architecture-specific package with catalogs, as an owner of codes is,
# whose language packs langpacks.py writes between the markers.
Name:           omx-fixture-owner
Version:        1.0.0
Release:        1%{?dist}
Summary:        An owner of codes, the fixture of the language packs
License:        GPL-3.0-or-later
URL:            https://www.openmixer.org

%description
The owner fixture of tests/langpacks.sh.

%prep

%build

%install
install -Dpm 0644 %{_sourcedir}/README %{buildroot}%{_datadir}/%{name}/README
for f in %{_sourcedir}/catalogs/*.json; do
    install -Dpm 0644 "$f" %{buildroot}%{_datadir}/%{name}/catalogs/$(basename "$f")
done

%files
%{_datadir}/%{name}/README

# BEGIN langpacks: generated by langpacks.py, do not edit
%package langpack-ca
Summary: The ca catalog of omx-fixture-owner's codes
BuildArch: noarch
Requires: omx-fixture-owner = %{version}-%{release}
Supplements: (omx-fixture-owner and langpacks-ca)

%description langpack-ca
The sentences of omx-fixture-owner's codes in the language ca, read by every
surface that shows them on a host in that locale; without it a surface shows
the English source sentence.

%files langpack-ca
%{_datadir}/omx-fixture-owner/catalogs/ca.json

%package langpack-es
Summary: The es catalog of omx-fixture-owner's codes
BuildArch: noarch
Requires: omx-fixture-owner = %{version}-%{release}
Supplements: (omx-fixture-owner and langpacks-es)

%description langpack-es
The sentences of omx-fixture-owner's codes in the language es, read by every
surface that shows them on a host in that locale; without it a surface shows
the English source sentence.

%files langpack-es
%{_datadir}/omx-fixture-owner/catalogs/es.json
# END langpacks

