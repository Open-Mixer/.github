%:
	dh $@

override_dh_auto_install:
	install -Dpm 0644 README debian/tmp/usr/share/omx-fixture-owner/README
	set -e; for f in catalogs/*.json; do \
	    install -Dpm 0644 "$$f" debian/tmp/usr/share/omx-fixture-owner/catalogs/$$(basename "$$f"); \
	done
