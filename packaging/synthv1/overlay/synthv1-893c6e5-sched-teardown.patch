From 7db05bb7920bd3f3a7e13ad5e910dfaf4887b704 Mon Sep 17 00:00:00 2001
From: Pau Aliagas <linuxnow@gmail.com>
Date: Sat, 7 Nov 2026 15:24:46 +0100
Subject: [PATCH] - Fixed a crash on plug-in instance cleanup, racing the
 shared worker/schedule thread.

---
 ChangeLog             |  6 ++++++
 src/synthv1.cpp       |  3 +++
 src/synthv1_sched.cpp | 45 +++++++++++++++++++++++++++++++++++++++++--
 src/synthv1_sched.h   |  7 +++++--
 4 files changed, 57 insertions(+), 4 deletions(-)

diff --git a/ChangeLog b/ChangeLog
index 9bf614f..086465f 100644
--- a/ChangeLog
+++ b/ChangeLog
@@ -4,6 +4,12 @@ synthv1 - an old-school polyphonic synthesizer
 ChangeLog
 
 
+GIT HEAD
+
+- Fixed a crash on plug-in instance cleanup, racing the shared worker/schedule thread.
+
+
+
 1.5.1  2026-10-29  An Autumn'26 Release.
 
 - Cosmetic fix to parameter dial/knob modified value colors.
diff --git a/src/synthv1.cpp b/src/synthv1.cpp
index dc02e4c..bb3ab28 100644
--- a/src/synthv1.cpp
+++ b/src/synthv1.cpp
@@ -2791,6 +2791,9 @@ synthv1::synthv1 ( uint16_t nchannels, float srate, uint32_t nsize )
 
 synthv1::~synthv1 (void)
 {
+	// no scheduled run may reach a half-destroyed instance.
+	synthv1_sched::sync_cancel(this);
+
 	delete m_pImpl;
 }
 
diff --git a/src/synthv1_sched.cpp b/src/synthv1_sched.cpp
index a1305d8..5d03fdb 100644
--- a/src/synthv1_sched.cpp
+++ b/src/synthv1_sched.cpp
@@ -51,6 +51,10 @@ class synthv1_sched_thread : public QThread
 	// clear all pending runs immediately.
 	void sync_reset();
 
+	// cancel pending runs of an instance or a schedule, immediately.
+	void sync_cancel(synthv1 *pSynth);
+	void sync_cancel(synthv1_sched *sched);
+
 protected:
 
 	// main thread executive.
@@ -111,8 +115,8 @@ synthv1_sched_thread::synthv1_sched_thread ( uint32_t nsize ) : QThread()
 // dtor.
 synthv1_sched_thread::~synthv1_sched_thread (void)
 {
-	// fake sync and wait
-	if (m_running && isRunning()) do {
+	// fake sync and wait (even if not yet running)
+	if (isRunning()) do {
 		if (m_mutex.tryLock()) {
 			m_running = false;
 			m_cond.wakeAll();
@@ -160,6 +164,32 @@ void synthv1_sched_thread::sync_reset (void)
 }
 
 
+// cancel pending runs of an instance, immediately;
+// waits for the one in progress, as run_process() holds the lock.
+void synthv1_sched_thread::sync_cancel ( synthv1 *pSynth )
+{
+	QMutexLocker locker(&m_mutex);
+
+	for (uint32_t i = 0; i < m_nsize; ++i) {
+		synthv1_sched *sched = m_items[i];
+		if (sched && sched->instance() == pSynth)
+			m_items[i] = nullptr;
+	}
+}
+
+
+// cancel pending runs of a schedule, immediately.
+void synthv1_sched_thread::sync_cancel ( synthv1_sched *sched )
+{
+	QMutexLocker locker(&m_mutex);
+
+	for (uint32_t i = 0; i < m_nsize; ++i) {
+		if (m_items[i] == sched)
+			m_items[i] = nullptr;
+	}
+}
+
+
 void synthv1_sched_thread::clear (void)
 {
 	m_iread  = 0;
@@ -231,6 +261,9 @@ synthv1_sched::synthv1_sched ( synthv1 *pSynth, Type stype, uint32_t nsize )
 // dtor (virtual).
 synthv1_sched::~synthv1_sched (void)
 {
+	if (g_sched_thread)
+		g_sched_thread->sync_cancel(this);
+
 	delete [] m_items;
 
 	if (--g_sched_refcount == 0) {
@@ -314,6 +347,14 @@ void synthv1_sched::sync_pending (void)
 }
 
 
+// cancel pending schedules of an instance, immediately. (static)
+void synthv1_sched::sync_cancel ( synthv1 *pSynth )
+{
+	if (g_sched_thread)
+		g_sched_thread->sync_cancel(pSynth);
+}
+
+
 void synthv1_sched::sync_reset (void)
 {
 	if (g_sched_thread)
diff --git a/src/synthv1_sched.h b/src/synthv1_sched.h
index 7e70d8c..df87a6b 100644
--- a/src/synthv1_sched.h
+++ b/src/synthv1_sched.h
@@ -57,8 +57,8 @@ class synthv1_sched
 	// scheduled processor.
 	void sync_process();
 
-	// (pure) virtual processor.
-	virtual void process(int sid) = 0;
+	// virtual processor.
+	virtual void process(int /*sid*/) {}
 
 	// signal broadcast (static).
 	static void sync_notify(synthv1 *pSynth, Type stype, int sid);
@@ -88,6 +88,9 @@ class synthv1_sched
 	static void sync_pending();
 	static void sync_reset();
 
+	// cancel pending schedules of an instance, immediately. (static)
+	static void sync_cancel(synthv1 *pSynth);
+
 private:
 
 	// instance variables.
