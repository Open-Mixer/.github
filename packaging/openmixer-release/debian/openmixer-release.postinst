#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>
# The package carries an apt source per Debian release; /etc/apt/sources.list.d/openmixer.sources links the one
# of this system's VERSION_CODENAME, so an upgrade of the package changes the source it points at. Ubuntu takes the
# trixie source (the channel serves no Ubuntu tree; its packages are Architecture: all or build on trixie's
# libraries, as the Ubuntu CI jobs used before this package). A release the channel does not serve fails the
# install rather than add a source with no index.
set -e

if [ "$1" = configure ]; then
    # shellcheck source=/dev/null
    codename=$(. /etc/os-release && echo "${VERSION_CODENAME:-}")
    if [ "$(. /etc/os-release && echo "${ID:-}")" = ubuntu ]; then
        codename=trixie
    fi
    src=/usr/share/openmixer-release/openmixer-$codename.sources
    if [ -z "$codename" ] || [ ! -f "$src" ]; then
        served=
        for f in /usr/share/openmixer-release/openmixer-*.sources; do
            f=${f##*/openmixer-}
            served="$served${f%.sources} "
        done
        echo "openmixer-release: OpenMixer serves ${served}and this system is '${codename:-unknown}'" >&2
        exit 1
    fi
    ln -sfn "$src" /etc/apt/sources.list.d/openmixer.sources

    # The testing source, the staging channel (as Fedora's updates-testing), is written from the package's copy
    # for this release at every configure, so a new URI or key reaches the machine with the upgrade; the one line
    # a tester changes, Enabled, keeps its value ("Enabled: yes" exactly; anything else is no). A release the
    # testing channel does not serve gets no testing source.
    testing=/etc/apt/sources.list.d/openmixer-testing.sources
    tsrc=/usr/share/openmixer-release/testing/openmixer-testing-$codename.sources
    if [ -f "$tsrc" ]; then
        enabled=no
        if [ -f "$testing" ] && grep -qx 'Enabled: yes' "$testing"; then
            enabled=yes
        fi
        sed "s/^Enabled: no\$/Enabled: $enabled/" "$tsrc" > "$testing.dpkg-new"
        chmod 644 "$testing.dpkg-new"
        mv -f "$testing.dpkg-new" "$testing"
    else
        rm -f "$testing"
    fi
fi

#DEBHELPER#

exit 0
